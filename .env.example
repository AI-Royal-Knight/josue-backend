# ==========================================
# Environment & Core Django Settings
# ==========================================
# Options: 'dev' or 'prod' (defaults to 'dev')
# - 'dev' loads config.settings.dev (DEBUG=True)
# - 'prod' loads config.settings.prod (DEBUG=False, strict SSL/HSTS)
ENVIRONMENT=dev

# Django Secret Key (Required)
# Generate one using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-this-to-a-secure-random-secret-key-in-production

# Debug Mode (optional override; dev settings default to True, prod to False)
DEBUG=True

# ==========================================
# Networking, Hosts & Security
# ==========================================
# Comma-separated list of allowed host header values
ALLOWED_HOSTS=*

# Comma-separated list of origins authorized to make cross-site HTTP requests
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://tresta.cloud,https://www.tresta.cloud,https://api.tresta.cloud,https://josue.tripmate.cloud

# Comma-separated list of trusted origins for CSRF protection
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://tresta.cloud,https://www.tresta.cloud,https://api.tresta.cloud,https://josue.tripmate.cloud

# Frontend Application Base URL (used for password reset, email invitations, redirects)
FRONTEND_URL=http://localhost:3000

# ==========================================
# Email Configuration (Brevo / Anymail)
# ==========================================
# Brevo (formerly Sendinblue) API key for sending transactional emails
BREVO_API_KEY=

# Default email address shown in the 'From' field for system emails
DEFAULT_FROM_EMAIL=no-reply@blinkdeal.cc

# ==========================================
# Cloudinary Storage Configuration
# ==========================================
# Credentials for Cloudinary media upload and storage
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# Celery & Redis Configuration
# ==========================================
# Redis broker and result backend URLs
# For local development without Docker: redis://localhost:6379/0
# For Docker Compose setup: redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
